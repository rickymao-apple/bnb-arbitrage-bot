# 监控模式：此版本不支持开仓、平仓、自动执行或自动止盈止损。
[binance]
# 扫描公开行情无需凭证；余额与持仓查询只需要只读权限。
futures_api_key =
futures_secret_key =
spot_api_key =
spot_secret_key =
testnet = true

[trading]
# 为空时扫描全部匹配的合约与现货，也可用 BTCUSDT,ETHUSDT。
enabled_pairs = []
min_funding_rate = 0.01
# 以下交易参数仅保留兼容，不触发交易。
max_trade_amount = 1000
leverage = 3
auto_execute = false

[monitoring]
refresh_interval = 30

[database]
db_path = ./data/arbitrage.db

[server]
host = 127.0.0.1
port = 5000
debug = false
