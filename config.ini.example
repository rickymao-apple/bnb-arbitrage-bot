# 币安套利机器人配置
# 请勿将敏感信息提交到版本控制！

[binance]
# 现货 API 配置（可选，留空则使用永续合约账户）
spot_api_key = ""
spot_secret_key = ""

# 永续合约 API 配置
futures_api_key = ""
futures_secret_key = ""

# API 权限设置（建议只开启合约交易和读取权限）
# 可用权限: spot, margin, futures, option

[trading]
# 交易对过滤
enabled_pairs = []

# 最小资金费率阈值（%），只有超过此值才触发套利
min_funding_rate = 0.01

# 单笔最大交易金额 (USDT)
max_trade_amount = 1000

# 初始保证金比例
leverage = 3

# 是否自动执行交易（True=自动执行，False=仅监控）
auto_execute = false

[monitoring]
# 数据刷新间隔（秒）
refresh_interval = 5

# 是否启用 TG 通知（待实现）
telegram_enabled = false
telegram_token = ""
telegram_chat_id = ""

[database]
# SQLite 数据库路径
db_path = ./data/arbitrage.db

[server]
# Web 服务端口
port = 5000
debug = true

[logging]
log_level = INFO
log_file = ./logs/arbitrage.log
